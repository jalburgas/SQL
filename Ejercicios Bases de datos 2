-- Consulta 1: Empleados en más de 2 proyectos
SELECT e.nombre, e.apellido, COUNT(a.id_proyecto) as num_proyectos
FROM empleados e
JOIN asignaciones a ON e.id = a.id_empleado
GROUP BY e.id
HAVING num_proyectos > 2;

