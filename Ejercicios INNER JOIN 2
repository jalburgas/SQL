-- Solución
SELECT v.id_venta,
       v.fecha_venta,
       CONCAT(c.nombre, ' ', c.apellido) AS cliente,
       p.nombre_producto,
       CONCAT(vd.nombre_vendedor, ' ', vd.apellido_vendedor) AS vendedor,
       v.cantidad,
       (p.precio * v.cantidad) AS total
FROM ventas v
INNER JOIN clientes c ON v.id_cliente = c.id_cliente
INNER JOIN productos p ON v.id_producto = p.id_producto
INNER JOIN vendedores vd ON v.id_vendedor = vd.id_vendedor
WHERE v.fecha_venta BETWEEN '2024-01-01' AND '2024-02-29'
ORDER BY v.fecha_venta;

Ejercicio 8: JOIN con HAVING (filtro sobre agregación)

Mostrar clientes que hayan comprado más de 2 productos en total:
sql

-- Solución
SELECT CONCAT(c.nombre, ' ', c.apellido) AS cliente,
       COUNT(v.id_venta) AS numero_ventas,
       SUM(v.cantidad) AS total_productos,
       SUM(p.precio * v.cantidad) AS total_gastado
FROM ventas v
INNER JOIN clientes c ON v.id_cliente = c.id_cliente
INNER JOIN productos p ON v.id_producto = p.id_producto
GROUP BY c.id_cliente, c.nombre, c.apellido
HAVING SUM(v.cantidad) > 2;

🏆 Ejercicio Bonus (4 tablas + subconsulta)

Encontrar el producto más vendido (por cantidad) y mostrar quién lo compró y quién lo vendió:
sql

-- Solución
SELECT p.nombre_producto,
       SUM(v.cantidad) AS total_vendido,
       CONCAT(c.nombre, ' ', c.apellido) AS comprador,
       CONCAT(vd.nombre_vendedor, ' ', vd.apellido_vendedor) AS vendedor,
       COUNT(v.id_venta) AS numero_transacciones
FROM ventas v
INNER JOIN productos p ON v.id_producto = p.id_producto
INNER JOIN clientes c ON v.id_cliente = c.id_cliente
INNER JOIN vendedores vd ON v.id_vendedor = vd.id_vendedor
GROUP BY p.id_producto, p.nombre_producto, c.id_cliente, c.nombre, c.apellido, 
         vd.id_vendedor, vd.nombre_vendedor, vd.apellido_vendedor
HAVING total_vendido = (
    SELECT MAX(total_vendido)
    FROM (
        SELECT SUM(cantidad) AS total_vendido
        FROM ventas
        GROUP BY id_producto
    ) AS subquery
);
