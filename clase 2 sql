3. Consultas avanzadas
WHERE con operadores lógicos
sql
-- Empleados con salario entre 2500 y 3000
SELECT * FROM empleados 
WHERE salario BETWEEN 2500 AND 3000;

-- Empleados de TI o Ventas (usando IN)
SELECT * FROM empleados 
WHERE departamento_id IN (1, 2);

-- Empleados cuyo nombre empiece con 'J' (usando LIKE)
SELECT * FROM empleados 
WHERE nombre LIKE 'J%';
ORDER BY múltiple
sql
-- Ordenar por departamento ascendente y salario descendente
SELECT * FROM empleados 
ORDER BY departamento_id ASC, salario DESC;
