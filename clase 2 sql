1. Comandos UPDATE y DELETE (Fundamentales)
UPDATE - Modificar datos existentes
sql
-- Sintaxis básica
UPDATE nombre_tabla 
SET columna1 = valor1, columna2 = valor2 
WHERE condición;

-- Ejemplos prácticos:
USE empresa;

-- Actualizar un solo campo
UPDATE empleados 
SET salario = 2750 
WHERE cedula = '13312024';

-- Actualizar múltiples campos
UPDATE empleados 
SET nombre = 'Juan Carlos Pérez', email = 'juancarlos@empresa.com'
WHERE cedula = '13312024';

-- Actualizar usando operadores matemáticos
UPDATE empleados 
SET salario = salario * 1.15  -- Aumento del 15%
WHERE departamento_id = 2;

-- Actualizar con subconsulta
UPDATE empleados 
SET salario = salario * 1.20
WHERE departamento_id = (
    SELECT id FROM departamentos WHERE nombre = 'Ventas'
);

-- Actualizar múltiples registros (cuidado sin WHERE)
UPDATE empleados 
SET fecha_ingreso = CURDATE() 
WHERE fecha_ingreso IS NULL;

-- Actualizar con JOIN (MySQL)
UPDATE empleados e
JOIN departamentos d ON e.departamento_id = d.id
SET e.salario = e.salario * 1.10
WHERE d.nombre = 'TI';
DELETE - Eliminar registros
sql
-- Sintaxis básica
DELETE FROM nombre_tabla WHERE condición;

-- Ejemplos:
-- Eliminar un empleado específico
DELETE FROM empleados 
WHERE cedula = '13312024';

-- Eliminar con múltiples condiciones
DELETE FROM empleados 
WHERE salario < 2000 AND departamento_id = 3;

-- Eliminar usando subconsulta
DELETE FROM empleados 
WHERE departamento_id = (
    SELECT id FROM departamentos WHERE nombre = 'Recursos Humanos'
);

-- Eliminar con JOIN (MySQL)
DELETE e 
FROM empleados e
JOIN departamentos d ON e.departamento_id = d.id
WHERE d.nombre = 'Ventas' AND e.salario < 2500;

-- ⚠️ PELIGRO: Eliminar TODOS los registros (sin WHERE)
DELETE FROM empleados;  -- Borra todo, ¡cuidado!

-- Alternativa segura: usar LIMIT
DELETE FROM empleados 
WHERE salario < 1500 
LIMIT 5;  -- Elimina solo 5 registros
TRUNCATE - Eliminar todos los registros RÁPIDO
sql
-- TRUNCATE vs DELETE:
-- DELETE: Elimina uno por uno, se puede deshacer (ROLLBACK)
-- TRUNCATE: Elimina toda la tabla de golpe, más rápido, NO se puede deshacer

TRUNCATE TABLE empleados;  -- Borra todos los registros y reinicia AUTO_INCREMENT
