3. Restricciones que Afectan UPDATE/DELETE
FOREIGN KEY - Lo más importante
sql
-- Al crear tabla con FOREIGN KEY
CREATE TABLE proyectos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100),
    empleado_cedula VARCHAR(20),
    FOREIGN KEY (empleado_cedula) REFERENCES empleados(cedula)
    ON DELETE CASCADE  -- Opciones: CASCADE, SET NULL, RESTRICT, NO ACTION
    ON UPDATE CASCADE
);

-- Opciones de FOREIGN KEY:
-- CASCADE:    Si borras/actualizas el padre, se borra/actualiza el hijo
-- SET NULL:   Si borras el padre, el hijo queda NULL
-- RESTRICT:   No deja borrar si hay hijos relacionados (default en MySQL)
-- NO ACTION:  Similar a RESTRICT

-- Ejemplo práctico:
CREATE TABLE pedidos (
    id INT PRIMARY KEY,
    cliente_id INT,
    FOREIGN KEY (cliente_id) REFERENCES clientes(id)
    ON DELETE RESTRICT  -- No deja eliminar cliente con pedidos
);

-- Ver restricciones existentes
SHOW CREATE TABLE empleados;
