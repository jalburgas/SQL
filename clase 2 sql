2. Prácticas Seguras con UPDATE y DELETE
⚠️ Siempre probar antes de ejecutar
sql
-- 1. Primero verifica qué vas a actualizar/eliminar
SELECT * FROM empleados WHERE salario < 2000;

-- 2. Si es correcto, ejecuta la acción
DELETE FROM empleados WHERE salario < 2000;

-- 3. Usar TRANSACCIONES para poder deshacer
START TRANSACTION;
UPDATE empleados SET salario = salario * 2 WHERE departamento_id = 1;
-- Verifica el cambio
SELECT * FROM empleados WHERE departamento_id = 1;
-- Si está bien:
COMMIT;
-- Si está mal:
ROLLBACK;
Crear BACKUP antes de modificar
sql
-- Crear tabla respaldo
CREATE TABLE empleados_backup AS SELECT * FROM empleados;

-- O copiar solo algunos
CREATE TABLE empleados_respaldo AS 
SELECT * FROM empleados WHERE departamento_id = 1;

-- Restaurar si es necesario
INSERT INTO empleados SELECT * FROM empleados_backup;
