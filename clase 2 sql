1. Restricciones (Constraints)
Cuando creas una tabla, puedes definir reglas para los datos:
sql
CREATE DATABASE empresa;
USE empresa;

-- Tabla con restricciones
CREATE TABLE empleados (
    cedula INT PRIMARY KEY,           -- No se repite ni es NULL
    nombre VARCHAR(100) NOT NULL,     -- No puede estar vacío
    email VARCHAR(100) UNIQUE,        -- No se puede repetir
    salario DECIMAL(10,2) CHECK (salario > 0),  -- Validación
    departamento_id INT,
    fecha_ingreso DATE DEFAULT CURDATE()  -- Valor por defecto
);

CREATE TABLE departamentos (
    id INT PRIMARY KEY AUTO_INCREMENT,  -- Auto numérico
    nombre VARCHAR(50) NOT NULL
);

-- FOREIGN KEY: relación entre tablas
ALTER TABLE empleados 
ADD FOREIGN KEY (departamento_id) REFERENCES departamentos(id);
