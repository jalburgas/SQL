4. Funciones de Agregación
sql
-- Contar empleados
SELECT COUNT(*) AS total_empleados FROM empleados;

-- Salario promedio por departamento
SELECT departamento_id, AVG(salario) AS salario_promedio
FROM empleados
GROUP BY departamento_id;

-- Salario máximo y mínimo
SELECT MAX(salario) AS mayor_salario, MIN(salario) AS menor_salario
FROM empleados;

-- Suma total de salarios
SELECT SUM(salario) AS total_nomina FROM empleados;
________________________________________
5. GROUP BY y HAVING
sql
-- Contar empleados por departamento (solo departamentos con más de 1 empleado)
SELECT departamento_id, COUNT(*) AS cantidad
FROM empleados
GROUP BY departamento_id
HAVING COUNT(*) > 1;
________________________________________
6. JOIN (Relacionar tablas)
INNER JOIN (muestra solo coincidencias)
sql
SELECT e.cedula, e.nombre, e.salario, d.nombre AS departamento
FROM empleados e
INNER JOIN departamentos d ON e.departamento_id = d.id;
LEFT JOIN (muestra todos los empleados, tengan o no departamento)
sql
SELECT e.nombre, d.nombre AS departamento
FROM empleados e
LEFT JOIN departamentos d ON e.departamento_id = d.id;
________________________________________
7. Subconsultas
sql
-- Empleados con salario superior al promedio
SELECT nombre, salario
FROM empleados
WHERE salario > (SELECT AVG(salario) FROM empleados);

-- Empleados del departamento con más empleados
SELECT nombre, departamento_id
FROM empleados
WHERE departamento_id = (
    SELECT departamento_id
    FROM empleados
    GROUP BY departamento_id
    ORDER BY COUNT(*) DESC
    LIMIT 1
);
