4. Ejemplo Completo con UPDATE y DELETE
sql
-- Crear base de datos completa
CREATE DATABASE tienda;
USE tienda;

-- Tabla categorías
CREATE TABLE categorias (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    activa BOOLEAN DEFAULT TRUE
);

-- Tabla productos
CREATE TABLE productos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL,
    precio DECIMAL(10,2),
    stock INT DEFAULT 0,
    categoria_id INT,
    FOREIGN KEY (categoria_id) REFERENCES categorias(id)
    ON DELETE SET NULL  -- Si borro categoría, productos quedan sin categoría
    ON UPDATE CASCADE
);

-- Insertar datos
INSERT INTO categorias (nombre) VALUES 
('Electrónica'), ('Ropa'), ('Libros');

INSERT INTO productos (nombre, precio, stock, categoria_id) VALUES
('Laptop', 800, 10, 1),
('Mouse', 25, 50, 1),
('Camisa', 30, 100, 2),
('Novela', 15, 30, 3);

-- EJERCICIOS CON UPDATE
-- 1. Aumentar precio 10% a todos
UPDATE productos SET precio = precio * 1.10;

-- 2. Descontar stock después de venta
UPDATE productos 
SET stock = stock - 5 
WHERE nombre = 'Laptop';

-- 3. Actualizar con JOIN
UPDATE productos p
JOIN categorias c ON p.categoria_id = c.id
SET p.precio = p.precio * 0.85  -- 15% descuento
WHERE c.nombre = 'Electrónica';

-- EJERCICIOS CON DELETE
-- 4. Eliminar productos sin stock
DELETE FROM productos WHERE stock = 0;

-- 5. Eliminar categoría (ver cómo afecta ON DELETE SET NULL)
DELETE FROM categorias WHERE nombre = 'Ropa';
-- Los productos de ropa ahora tienen categoria_id = NULL

-- 6. Eliminar con subconsulta
DELETE FROM productos 
WHERE categoria_id IN (
    SELECT id FROM categorias WHERE activa = FALSE
);
