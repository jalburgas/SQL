INSERT INTO productos (nombre, precio, stock, id_categoria) VALUES
('Laptop', 800.00, 10, 1),
('Mouse', 20.50, 50, 1),
('Camisa', 25.00, 30, 2),
('Sartén', 15.00, 20, 3);

4. Crear procedimientos almacenados

a) Procedimiento que muestre todos los productos
sql

DELIMITER //
CREATE PROCEDURE listar_productos()
BEGIN
    SELECT * FROM productos;
END //
DELIMITER ;

CALL listar_productos();

b) Procedimiento para agregar un nuevo producto
sql

DELIMITER //
CREATE PROCEDURE agregar_producto(
    IN p_nombre VARCHAR(100),
    IN p_precio DECIMAL(10,2),
    IN p_stock INT,
    IN p_id_categoria INT
)
BEGIN
    INSERT INTO productos (nombre, precio, stock, id_categoria)
    VALUES (p_nombre, p_precio, p_stock, p_id_categoria);
END //
DELIMITER ;

CALL agregar_producto('Teclado', 45.00, 15, 1);

c) Procedimiento para actualizar stock
sql

DELIMITER //
CREATE PROCEDURE actualizar_stock(
    IN p_id_producto INT,
    IN p_nuevo_stock INT
)
BEGIN
    UPDATE productos
    SET stock = p_nuevo_stock
    WHERE id = p_id_producto;
END //
DELIMITER ;

CALL actualizar_stock(2, 60);

🧩 Ejercicio 2: Base de datos – Biblioteca
1. Crear base de datos
sql

CREATE DATABASE biblioteca;
USE biblioteca;

2. Crear tablas
sql

CREATE TABLE autores (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    nacionalidad VARCHAR(50)
);

CREATE TABLE libros (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    anio INT,
    id_autor INT,
    FOREIGN KEY (id_autor) REFERENCES autores(id)
);

