4. Procedimientos almacenados

a) Listar libros con su autor
sql

DELIMITER //
CREATE PROCEDURE libros_con_autor()
BEGIN
    SELECT l.titulo, l.anio, a.nombre AS autor
    FROM libros l
    JOIN autores a ON l.id_autor = a.id;
END //
DELIMITER ;

CALL libros_con_autor();

b) Insertar un nuevo libro
sql

DELIMITER //
CREATE PROCEDURE insertar_libro(
    IN p_titulo VARCHAR(150),
    IN p_anio INT,
    IN p_id_autor INT
)
BEGIN
    INSERT INTO libros (titulo, anio, id_autor)
    VALUES (p_titulo, p_anio, p_id_autor);
END //
DELIMITER ;

c) Procedimiento con validación (año no futuro)
sql

DELIMITER //
CREATE PROCEDURE insertar_libro_valido(
    IN p_titulo VARCHAR(150),
    IN p_anio INT,
    IN p_id_autor INT
)
BEGIN
    IF p_anio <= YEAR(CURDATE()) THEN
        INSERT INTO libros (titulo, anio, id_autor)
        VALUES (p_titulo, p_anio, p_id_autor);
    ELSE
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'El año no puede ser futuro';
    END IF;
END //
DELIMITER ;

🧩 Ejercicio 3: Procedimiento con parámetro de salida (OUT)
Calcular total de productos por categoría
sql

DELIMITER //
CREATE PROCEDURE contar_productos_por_categoria(
    IN p_id_categoria INT,
    OUT p_total INT
)
BEGIN
    SELECT COUNT(*) INTO p_total
    FROM productos
    WHERE id_categoria = p_id_categoria;
END //
DELIMITER ;

CALL contar_productos_por_categoria(1, @total);
SELECT @total;

🧩 Ejercicio 4: Procedimiento con bucle y condicional
Aplicar descuento si stock es bajo
sql

DELIMITER //
CREATE PROCEDURE aplicar_descuento()
BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE prod_id INT;
    DECLARE prod_stock INT;
    DECLARE cur CURSOR FOR SELECT id, stock FROM productos;
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;

    OPEN cur;
    read_loop: LOOP
        FETCH cur INTO prod_id, prod_stock;
        IF done THEN
            LEAVE read_loop;
        END IF;
        IF prod_stock < 10 THEN
            UPDATE productos SET precio = precio * 0.9 WHERE id = prod_id;
        END IF;
    END LOOP;
    CLOSE cur;
END //
DELIMITER ;

